<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <RootNamespace>VpuSimulator.ArchitectureTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Kiểm tra luật kiến trúc bằng reflection, chạy như unit test thường trong CI.
             Version dưới đây chỉ là điểm xuất phát: khi add vào solution, chạy
             `dotnet add package <tên>` (không kèm (2 trừ)version) để lấy bản ổn định mới nhất
             tương thích net10.0. -->
        <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
        <PackageReference Include="xunit" Version="2.9.2" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <!-- Đúng tên project trong solution hiện tại (thư mục nằm ngang hàng với VpuSimulator.sln).
             KHÔNG reference VpuSimulator.Api: test chỉ cần biết Api là "tên namespace cấm" (chuỗi),
             không cần nạp assembly Web SDK vào test host. -->
        <ProjectReference Include="..\VpuSimulator.Domain\VpuSimulator.Domain.csproj" />
        <ProjectReference Include="..\VpuSimulator.Application\VpuSimulator.Application.csproj" />
        <ProjectReference Include="..\VpuSimulator.Infrastructure\VpuSimulator.Infrastructure.csproj" />
        <ProjectReference Include="..\VpuSimulator.Rules\VpuSimulator.Rules.csproj" />
        <ProjectReference Include="..\VpuSimulator.EventBuilder\VpuSimulator.EventBuilder.csproj" />
    </ItemGroup>

</Project>