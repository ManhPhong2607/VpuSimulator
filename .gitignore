project.fragment.lock.json
.nuget/

# ---- Secrets & cấu hình cục bộ (KHÔNG commit) ----
# appsettings.json và appsettings.Development.json vẫn được commit (chỉ chứa giá trị mặc định, không có secret).
appsettings.*.local.json
appsettings.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem
.env
.env.*
!.env.example

# ---- Dữ liệu chạy local ----
# Log Serilog ghi ra file, dữ liệu Docker volume, durable upload queue (FR-OBJ-6)
*.log
logs/
data/
.data/
upload-queue/
.docker-volumes/

# ---- Docker / compose override cục bộ ----
docker-compose.override.yml

# ---- Console (Next.js) ----
console/node_modules/
console/.next/
console/out/
console/.turbo/
console/.vercel/
console/*.tsbuildinfo
console/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
